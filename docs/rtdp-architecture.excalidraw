e, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Real model fixture\nMinIO artifact + schema\nWarmup + parity checks\nNo random score stubs", "originalText": "Real model fixture\nMinIO artifact + schema\nWarmup + parity checks\nNo random score stubs", "fontSize": 19, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "re145", "lineHeight": 1.25, "autoResize": true}, {"id": "ar147", "type": "arrow", "x": 3945.0, "y": 1855, "width": 20.0, "height": 70, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr109", "roundness": null, "seed": 1789442529, "version": 1, "versionNonce": 522362321, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0.0, 0], [-20.0, -70]], "lastCommittedPoint": null, "startBinding": {"elementId": "re145", "focus": 0, "gap": 2}, "endBinding": {"elementId": "re117", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "te148", "type": "text", "x": 2765, "y": 2395, "width": 1153.1200000000001, "height": 22.5, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr109", "roundness": null, "seed": 1685192165, "version": 1, "versionNonce": 1898882740, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Proposed: decision p99 < 100 ms; feature visibility p95 <= 5 s; stale pipeline after 30 s invokes declared policy.", "originalText": "Proposed: decision p99 < 100 ms; feature visibility p95 <= 5 s; stale pipeline after 30 s invokes declared policy.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "te149", "type": "text", "x": 2765, "y": 2440, "width": 1270.16, "height": 21.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr109", "roundness": null, "seed": 1357122901, "version": 1, "versionNonce": 311583110, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Checkpoints recover managed state. Kafka transactions and idempotent stores define narrower guarantees; no global exactly-once claim.", "originalText": "Checkpoints recover managed state. Kafka transactions and idempotent stores define narrower guarantees; no global exactly-once claim.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "te150", "type": "text", "x": 2765, "y": 2485, "width": 1344.64, "height": 22.5, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr109", "roundness": null, "seed": 1033535610, "version": 1, "versionNonce": 1839700616, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Default Compose must start real Flink + inference. Validate duplicates, lateness, idle partitions, currency keys, and crash recovery.", "originalText": "Default Compose must start real Flink + inference. Validate duplicates, lateness, idle partitions, currency keys, and crash recovery.", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "fr151", "type": "frame", "x": 0, "y": 2750, "width": 2500, "height": 1250, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 314051310, "version": 1, "versionNonce": 913495727, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "name": "5 \u00b7 Authorized Actions and Acknowledged Effects"}, {"id": "te152", "type": "text", "x": 40, "y": 2778, "width": 810.4000000000001, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 1300430509, "version": 1, "versionNonce": 525488742, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Decision != action intent != acknowledged effect", "originalText": "Decision != action intent != acknowledged effect", "fontSize": 30, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "te153", "type": "text", "x": 40, "y": 2830, "width": 1136.88, "height": 21.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 663343194, "version": 1, "versionNonce": 1572745252, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Initial adapters are local simulators. Real enforcement authority and provider guarantees must be explicitly confirmed.", "originalText": "Initial adapters are local simulators. Real enforcement authority and provider guarantees must be explicitly confirmed.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "re154", "type": "rectangle", "x": 70, "y": 2920, "width": 390, "height": 145,