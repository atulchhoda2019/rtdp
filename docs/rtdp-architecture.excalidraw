2175.0, "width": 90, "height": 0.0, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr81", "roundness": null, "seed": 8196149, "version": 1, "versionNonce": 2059322682, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0, 0.0], [90, 0.0]], "lastCommittedPoint": null, "startBinding": {"elementId": "re101", "focus": 0, "gap": 2}, "endBinding": {"elementId": "re104", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "re107", "type": "rectangle", "x": 40, "y": 2325, "width": 2420, "height": 205, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr81", "roundness": {"type": 3}, "seed": 1477498383, "version": 1, "versionNonce": 364120812, "isDeleted": false, "boundElements": [{"type": "text", "id": "te108"}], "updated": 1, "link": null, "locked": false}, {"id": "te108", "type": "text", "x": 50, "y": 2372.5, "width": 2400, "height": 110.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr81", "roundness": null, "seed": 514982154, "version": 1, "versionNonce": 1668748296, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Isolation is an end-to-end invariant\nTenant + environment + mode belong in keys, caches, topics/correlation, audit, replay, and action idempotency.\nCatalog visibility is not execution entitlement. Parent identity is not implicit child-data access.\nActual hierarchy, entitlements, override limits, conflict policy, residency, and authority still need business confirmation.", "originalText": "Isolation is an end-to-end invariant\nTenant + environment + mode belong in keys, caches, topics/correlation, audit, replay, and action idempotency.\nCatalog visibility is not execution entitlement. Parent identity is not implicit child-data access.\nActual hierarchy, entitlements, override limits, conflict policy, residency, and authority still need business confirmation.", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "middle", "containerId": "re107", "lineHeight": 1.25, "autoResize": true}, {"id": "fr109", "type": "frame", "x": 2700, "y": 1450, "width": 2500, "height": 1150, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 856070306, "version": 1, "versionNonce": 2053134994, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "name": "4 \u00b7 Real Flink and AI Inference in the MVP"}, {"id": "te110", "type": "text", "x": 2740, "y": 1478, "width": 995.2, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr109", "roundness": null, "seed": 766744960, "version": 1, "versionNonce": 1863693998, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Decision latency and feature freshness are separate targets", "originalText": "Decision latency and feature freshness are separate targets", "fontSize": 30, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "te111", "type": "text", "x": 2740, "y": 1530, "width": 1203.5200000000002, "height": 21.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "str