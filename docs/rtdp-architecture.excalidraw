keStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 1119061846, "version": 1, "versionNonce": 359671404, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0.0, 0], [70.0, 125]], "lastCommittedPoint": null, "startBinding": {"elementId": "re176", "focus": 0, "gap": 2}, "endBinding": {"elementId": "re179", "focus": 0, "gap": 2}, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false}, {"id": "te182", "type": "text", "x": 220, "y": 3360, "width": 1051.2, "height": 21.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 955235052, "version": 1, "versionNonce": 286141623, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Definitive success/rejection can transition directly from DISPATCHING. Unsent work may expire or be cancelled.", "originalText": "Definitive success/rejection can transition directly from DISPATCHING. Unsent work may expire or be cancelled.", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "re183", "type": "rectangle", "x": 70, "y": 3460, "width": 1530, "height": 140, "angle": 0, "strokeColor": "#343a40", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": {"type": 3}, "seed": 1135808359, "version": 1, "versionNonce": 522601131, "isDeleted": false, "boundElements": [{"type": "text", "id": "te184"}], "updated": 1, "link": null, "locked": false}, {"id": "te184", "type": "text", "x": 80, "y": 3477.5, "width": 1510, "height": 105.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 1948942436, "version": 1, "versionNonce": 49591107, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Stable action identity\nidempotency_key = tenant + environment + decision + generation + action + target\nRetry attempt is NOT part of this identity.\nPayload conflict under the same key is rejected.", "originalText": "Stable action identity\nidempotency_key = tenant + environment + decision + generation + action + target\nRetry attempt is NOT part of this identity.\nPayload conflict under the same key is rejected.", "fontSize": 21, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "containerId": "re183", "lineHeight": 1.25, "autoResize": true}, {"id": "re185", "type": "rectangle", "x": 70, "y": 3680, "width": 2310, "height": 220, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f1f3f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": {"type": 3}, "seed": 1456645773, "version": 1, "versionNonce": 1794266953, "isDeleted": false, "boundElements": [{"type": "text", "id": "te186"}], "updated": 1, "link": null, "locked": false}, {"id": "te186", "type": "text", "x": 80, "y": 3721.25, "width": 2290, "height": 137.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr151", "roundness": null, "seed": 1150448851, "version": 1, "versionNonce": 555016297, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Safety invariants\nReplay/shadow: live dispatch prohibited at both orchestration and adapter boundaries.\nProvider timeout after possible effect -> UNKNOWN -> reconcile; no blind duplicate call.\nA lease alone cannot prevent duplicate external effects. Provider idempotency/fencing still matters.\nRollback changes future policy; it does not undo an acknowledged effect.", "originalText": "Safety invariants\nReplay/shadow: live dispatch prohibited at both orchestration and adapter boundaries.\nProvider timeout after possible effect -> UNKNOWN -> reconcile; no blind duplicate call.\nA lease alone cannot prevent duplicate external effects. Provider idempotency/fencing still matters.\nRollback changes future policy; it does not undo an acknowledged effect.", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "middle", "containerId": "re185", "lineHeight": 1.25, "autoResize": true}, {"id": "fr187", "type": "frame", "x": 2700, "y": 2750, "width": 2500, "height": 1250, "angle": 0, "strokeColor": "#bbb", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 185567036, "version": 1, "versionNonce": 1024075532, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "name": "6 \u00b7 Validated Configuration and Independent Activation"}, {"id": "te188", "type": "text", "x": 2740, "y": 2778, "width": 1112.8000000000002, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "fr187", "roundness": null, "seed": 470090439, "version": 1, "versionNonce": 693418589, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Deploy artifacts independently; activate compatible configurations", "originalText": "Deploy artifacts independently; activate compatible configurations", "fontSize": 30, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, 